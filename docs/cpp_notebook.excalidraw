    {
      "id": "IUby4p_Ut7D7eMbk5-P6i",
      "type": "text",
      "x": 170.08159922749263,
      "y": -61.12870379543972,
      "width": 1198.0191650390625,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
